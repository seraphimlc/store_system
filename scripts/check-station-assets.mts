/** Read-only TypeScript asset check. Never runs schema migrations or writes business data. */
import '../apps/server/node_modules/reflect-metadata/Reflect.js';import {readFile,mkdir,writeFile} from 'node:fs/promises';import {Database} from '../apps/server/src/database';import {StationRebuildService} from '../apps/server/src/station-rebuild';
const url=new URL(process.env.NEXT_DATABASE_URL??'');if(!['postgres:','postgresql:'].includes(url.protocol))throw Error('Explicit PostgreSQL URL required');if(process.argv.includes('--baseline')){if(!['127.0.0.1','localhost'].includes(url.hostname))throw Error('Baseline audit must be local');url.pathname='/store_settle';}url.searchParams.set('options','-c default_transaction_read_only=on');const db=new Database({databaseUrl:url.href,sessionSecret:'asset-check-is-not-a-login-session-secret',cookieSecure:false,host:'127.0.0.1',port:3000});
try{
 if((await db.query("SELECT current_setting('default_transaction_read_only') AS mode")).rows[0].mode!=='on')throw Error('Read-only connection not enforced');
 const actor=(await db.query<{id:number}>("SELECT id FROM users WHERE role='admin' AND is_active=true AND status IN('active','leave') ORDER BY id LIMIT 1")).rows[0];if(!actor)throw Error('No active administrator for asset inspection');
 const service=new StationRebuildService(db),result=await service.audit(actor.id),preview=await service.preview(actor.id);let source:any=null;const file=process.argv.slice(2).find(value=>value!=='--baseline');if(file){const payload=JSON.parse(await readFile(file,'utf8'));if(!Array.isArray(payload.lines)||!Array.isArray(payload.stations))throw Error('Invalid railway reference JSON');source={lines:payload.lines.length,stations:payload.stations.length,matches:payload.lines.length===result.stats.sourceLines&&payload.stations.length===result.stats.sourceStations};}
 const output={capturedAt:new Date().toISOString(),database:url.pathname.slice(1),readOnly:true,...result,preview:{summary:preview.summary,lineCountsChanged:preview.lineCountsChanged,canApply:preview.canApply},source,healthy:result.healthy&&(source?.matches??true)};await mkdir('data/refactor',{recursive:true});await writeFile('data/refactor/station-asset-check.json',JSON.stringify(output,null,2)+'\n',{mode:0o600});console.log(JSON.stringify(output,null,2));if(!output.healthy)process.exitCode=1;
}finally{await db.onModuleDestroy();}
