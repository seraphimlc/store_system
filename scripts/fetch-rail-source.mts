/** N02-22 retrieval/preprocessing. No DB connection; new outputs only. */
import {readFile,stat,mkdir,writeFile} from 'node:fs/promises';import {resolve,dirname} from 'node:path';import {cacheRailSource,N02_ARCHIVE,PREFECTURE_SOURCE,readRailArchiveJson,publishRailFile,extractRailGeometry} from '../apps/server/src/rail-source';import {preprocessRailway,railPrefectures} from '../packages/domain/src/rail-preprocess';
const args=process.argv.slice(2),options:Record<string,string|boolean>={},valueFlags=new Set(['--archive','--prefectures','--cache','--output','--geometry-output']);for(let i=0;i<args.length;i++){if(args[i]==='--download'||args[i]==='--refresh')options[args[i]]=true;else if(valueFlags.has(args[i])&&args[i+1]&&!args[i+1].startsWith('--'))options[args[i]]=args[++i];else throw Error('Use --download or --archive/--prefectures, optional --cache/--refresh/--output/--geometry-output');}
if(!options['--download']&&(!options['--archive']||!options['--prefectures']))throw Error('Explicit offline files or --download required');if(options['--refresh']&&!options['--download'])throw Error('--refresh requires --download');if(options['--geometry-output']&&!options['--output'])throw Error('--geometry-output requires --output');
const cache=resolve(String(options['--cache']??'data/refactor/rail-cache'));let archive=typeof options['--archive']==='string'?resolve(options['--archive']):'',prefectures=typeof options['--prefectures']==='string'?resolve(options['--prefectures']):'';const provenance:any[]=[];
if(options['--download']){if(!archive){const downloaded=await cacheRailSource(N02_ARCHIVE,cache,{refresh:!!options['--refresh'],validate:async path=>{const value=await readRailArchiveJson(path,'UTF-8/N02-22_Station.geojson');if(value?.type!=='FeatureCollection'||!Array.isArray(value.features))throw Error('INVALID_STATION_GEOJSON');}});archive=downloaded.path;provenance.push({...downloaded,path:undefined});}if(!prefectures){const downloaded=await cacheRailSource(PREFECTURE_SOURCE,cache,{refresh:!!options['--refresh'],maxBytes:32*1024*1024,validate:async path=>{railPrefectures(JSON.parse(await readFile(path,'utf8')));}});prefectures=downloaded.path;provenance.push({...downloaded,path:undefined});}}
if(!(await stat(prefectures)).isFile()||(await stat(prefectures)).size>32*1024*1024)throw Error('Boundary file must be <=32MiB');
const stationData=await readRailArchiveJson(archive,'UTF-8/N02-22_Station.geojson'),boundary=JSON.parse(await readFile(prefectures,'utf8')),processed=preprocessRailway(stationData,boundary);let output:string|null=null,geometry:string|null=null;
if(typeof options['--output']==='string'){output=resolve(options['--output']);if(output===archive||output===prefectures)throw Error('Output must differ from inputs');await mkdir(dirname(output),{recursive:true});await publishRailFile(output,JSON.stringify(processed.payload)+'\n');}
if(typeof options['--geometry-output']==='string'){geometry=resolve(options['--geometry-output']);if([archive,prefectures,output].includes(geometry))throw Error('Geometry output must differ from other files');await mkdir(dirname(geometry),{recursive:true});await extractRailGeometry(archive,geometry);}
const result={capturedAt:new Date().toISOString(),databaseTouched:false,mode:output?'new-files':'dry-run',provenance,...processed.report,output,geometry};await mkdir('data/refactor',{recursive:true});await writeFile('data/refactor/p5-rail-source.json',JSON.stringify(result,null,2)+'\n',{mode:0o600});console.log(JSON.stringify(result,null,2));
