import {validateOsmRouteSnapshot} from '../packages/domain/src/osm-routes';
import {sequenceReference} from '../packages/domain/src/sequence-reference';import {validateRailGeometryReference} from '../packages/domain/src/rail-geometry';
/** Offline order update. Defaults to read-only preview; no Python runtime or network. */
import '../apps/server/node_modules/reflect-metadata/Reflect.js';import {mkdir,writeFile,readFile,stat} from 'node:fs/promises';import {Database} from '../apps/server/src/database';import {StationSequenceService} from '../apps/server/src/station-sequence';
const args=process.argv.slice(2),apply=args.includes('--apply'),baseline=args.includes('--baseline');let token:string|undefined,geometry:string|undefined,osm:string|undefined;for(let i=0;i<args.length;i++){if(['--apply','--baseline'].includes(args[i]))continue;if(args[i]==='--osm'&&args[i+1]){osm=args[++i];continue;}if(args[i]==='--geometry'&&args[i+1]){geometry=args[++i];continue;}if(args[i]==='--token'&&args[i+1]){token=args[++i];continue;}throw Error('Use --baseline, --apply, --token <preview-token>, --geometry <validated-json>, --osm <complete-snapshot>');}
let sources=sequenceReference;if(geometry){const info=await stat(geometry);if(!info.isFile()||info.size>32*1024*1024)throw Error('Geometry reference must be a regular file <=32 MiB');sources={...sequenceReference,geometry:validateRailGeometryReference(JSON.parse(await readFile(geometry,'utf8')))};}
if(osm){const info=await stat(osm);if(!info.isFile()||info.size>32*1024*1024)throw Error('OSM snapshot must be a regular file <=32 MiB');sources={...sources,osm:validateOsmRouteSnapshot(JSON.parse(await readFile(osm,'utf8')))};}
const url=new URL(process.env.NEXT_DATABASE_URL??'');if(!['postgres:','postgresql:'].includes(url.protocol))throw Error('Explicit PostgreSQL URL required');if(baseline){if(apply||!['localhost','127.0.0.1'].includes(url.hostname))throw Error('Baseline is local read-only');url.pathname='/store_settle';}if(apply&&(!token||!url.pathname.endsWith('_refactor_p1')||!['localhost','127.0.0.1'].includes(url.hostname)))throw Error('Apply requires local isolated _refactor_p1 and preview token');if(!apply)url.searchParams.set('options','-c default_transaction_read_only=on');
