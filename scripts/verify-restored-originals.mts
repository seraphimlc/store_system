/** Restored private originals: read-only metadata and in-memory parser verification, no row contents emitted. */
import '../apps/server/node_modules/reflect-metadata/Reflect.js';
import {createRequire} from 'node:module';import {createHash} from 'node:crypto';import {createReadStream} from 'node:fs';import {stat,mkdir,writeFile} from 'node:fs/promises';import {resolve} from 'node:path';
import {readUploadPath} from '../apps/server/src/private-files';import {parseVisitWorkbook,readWorkbookRows} from '../apps/server/src/visit-workbook';
const require=createRequire(new URL('../apps/server/package.json',import.meta.url)),{Pool}=require('pg'),url=new URL(process.env.NEXT_DATABASE_URL??'');if(!['postgres:','postgresql:'].includes(url.protocol)||!['localhost','127.0.0.1'].includes(url.hostname)||url.pathname!=='/store_settle')throw Error('Explicit local store_settle database required');url.searchParams.set('options','-c default_transaction_read_only=on');
const root=process.env.NEXT_LEGACY_UPLOAD_HOST_DIRECTORY;if(!root)throw Error('Restored legacy directory required');process.env.NEXT_LEGACY_UPLOAD_DIRECTORY=resolve(root);const pool=new Pool({connectionString:url.href,max:1});
async function checksum(path:string){const hash=createHash('sha256');for await(const chunk of createReadStream(path))hash.update(chunk);return hash.digest('hex');}
const evidence:any={capturedAt:new Date().toISOString(),database:'store_settle',readOnly:true,imports:[],reconciliation:[],retainedWithoutOriginal:[],errors:[],databaseWritten:false};
try{
 const imports=(await pool.query('SELECT id,stored_path,file_size,file_sha256,status,parsed_rows,layout FROM imports ORDER BY id')).rows;
 for(const row of imports){if(row.stored_path==='kept'&&row.file_size===0&&row.file_sha256.startsWith('kept-')){evidence.retainedWithoutOriginal.push({id:row.id,classification:'historical_retention_marker',source:'legacy/scripts/reset_august.py',originalAvailable:false});continue;}
  try{const path=readUploadPath(row.stored_path),before=await checksum(path);let emitted=0;const parsed=await parseVisitWorkbook(path,async()=>{emitted++;},row.layout??undefined);const same=before===await checksum(path);if(!same)throw Error('Original was modified');evidence.imports.push({id:row.id,available:true,parsed:true,rows:emitted,storedParsedRows:row.parsed_rows,rowCountMatches:emitted===row.parsed_rows,checksumMatchesStored:row.file_sha256===before,originalUnchanged:same,bytes:(await stat(path)).size});
  }catch(error){evidence.errors.push({domain:'imports',id:row.id,code:(error as any).code??'ORIGINAL_PARSE_FAILED'});}
 }
 const cache=new Map<string,number>();for(const row of (await pool.query("SELECT id,params->>'path' AS path FROM recon_tasks WHERE params->>'path' IS NOT NULL ORDER BY id")).rows){try{const path=readUploadPath(row.path);if(!cache.has(path)){let count=0;for await(const _row of readWorkbookRows(path))count++;cache.set(path,count);}evidence.reconciliation.push({id:row.id,available:true,workbookReadable:true,rows:cache.get(path)});}catch(error){evidence.errors.push({domain:'reconciliation',id:row.id,code:(error as any).code??'WORKBOOK_READ_FAILED'});}}
 evidence.ok=evidence.errors.length===0&&evidence.imports.every((row:any)=>row.originalUnchanged);await mkdir('data/refactor',{recursive:true});await writeFile('data/refactor/restored-originals-verification.json',JSON.stringify(evidence,null,2),{mode:0o600});console.log(JSON.stringify({ok:evidence.ok,imports:evidence.imports.length,parsedRows:evidence.imports.reduce((n:number,row:any)=>n+row.rows,0),importRowCountMismatches:evidence.imports.filter((row:any)=>!row.rowCountMatches).map((row:any)=>row.id),reconciliationReferences:evidence.reconciliation.length,uniqueReconFiles:cache.size,retainedWithoutOriginal:evidence.retainedWithoutOriginal,errors:evidence.errors,databaseWritten:false}));if(!evidence.ok)process.exitCode=1;
}finally{await pool.end();}
