const args=process.argv.slice(2),flags=new Set(['--all','--write','--baseline']),values=new Set(['--geojson','--output']),options:Record<string,string|boolean>={};for(let i=0;i<args.length;i++){if(flags.has(args[i]))options[args[i]]=true;else if(values.has(args[i])&&args[i+1]&&!args[i+1].startsWith('--'))options[args[i]]=args[++i];else throw Error('Use --geojson <file> [--all] [--write --output <new-file>] [--baseline]');}
if(typeof options['--geojson']!=='string')throw Error('Explicit --geojson path required; no automatic download');const source=resolve(options['--geojson']),sourceStat=await stat(source);if(!sourceStat.isFile()||sourceStat.size>256*1024*1024)throw Error('Geometry source must be a regular file of at most 256 MiB');
const geojson=JSON.parse(await readFile(source,'utf8')),sections=parseRailwaySections(geojson),url=new URL(process.env.NEXT_DATABASE_URL??'');if(!['postgres:','postgresql:'].includes(url.protocol))throw Error('Explicit PostgreSQL connection required');if(options['--baseline']){if(!['localhost','127.0.0.1'].includes(url.hostname))throw Error('Baseline must be local');url.pathname='/store_settle';}url.searchParams.set('options','-c default_transaction_read_only=on');
if(options['--write']&&typeof options['--output']!=='string')throw Error('--write requires an explicit new --output path');if(!options['--write']&&options['--output'])throw Error('--output requires --write');
const db=new Database({databaseUrl:url.href,sessionSecret:'geometry-cli-not-a-session-secret-at-least40',cookieSecure:false,port:3000,host:'127.0.0.1'});
try{
 if((await db.query("SELECT current_setting('default_transaction_read_only') AS mode")).rows[0].mode!=='on')throw Error('Read-only DB connection required');
 const snapshot=await db.transaction(async client=>{await client.query('SET TRANSACTION ISOLATION LEVEL REPEATABLE READ READ ONLY');return {lines:(await client.query<GeometryLine>('SELECT id,name,operator,n_station FROM bd_line ORDER BY id')).rows,stations:(await client.query<GeometryStation>('SELECT id,name,line_id,lat,lon,seq_src FROM bd_station ORDER BY id')).rows};});
 const result=generateRailGeometry(snapshot.lines,snapshot.stations,sections,!!options['--all']),{skipped,osmSkipped,...payload}=result;let output:string|null=null;
 if(options['--write']){
  output=resolve(String(options['--output']));if(output===source)throw Error('Output must differ from input');await mkdir(dirname(output),{recursive:true});
  const temporary=output+'.'+randomUUID()+'.tmp',handle=await open(temporary,'wx',0o600);try{await handle.writeFile(JSON.stringify(payload)+'\n');await handle.sync();await handle.close();await link(temporary,output);}finally{await handle.close().catch(()=>{});await unlink(temporary).catch(()=>{});}
 }
 const report={capturedAt:new Date().toISOString(),database:url.pathname.slice(1),readOnly:true,mode:options['--write']?'write-new-file':'dry-run',sections:sections.length,generatedLines:payload.n_line,osmSkipped,skipped,output};await mkdir('data/refactor',{recursive:true});await writeFile('data/refactor/p5-geometry-cli.json',JSON.stringify(report,null,2)+'\n',{mode:0o600});console.log(JSON.stringify(report,null,2));
}finally{await db.onModuleDestroy();}
