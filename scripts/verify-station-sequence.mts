import {spawnLegacyPython} from './legacy-python.mjs';
/** Full local station-asset parity. Legacy script uses an in-memory adapter, not a write connection. */
import '../apps/server/node_modules/reflect-metadata/Reflect.js';import {spawnSync} from 'node:child_process';import {mkdir,writeFile} from 'node:fs/promises';import {Database} from '../apps/server/src/database';import {planStationSequence,type SequenceLine,type SequenceStation} from '../packages/domain/src/station-sequence';import {sequenceReference} from '../packages/domain/src/sequence-reference';
const url=new URL(process.env.NEXT_DATABASE_URL??'');if(!['localhost','127.0.0.1'].includes(url.hostname))throw Error('Local baseline only');url.pathname='/store_settle';url.searchParams.set('options','-c default_transaction_read_only=on');const db=new Database({databaseUrl:url.href,sessionSecret:'sequence-parity-not-login-secret-at-least40',cookieSecure:false,port:3000,host:'127.0.0.1'});
try{
 if((await db.query("SELECT current_setting('default_transaction_read_only') AS mode")).rows[0].mode!=='on')throw Error('Read-only connection required');
 const lines=(await db.query<SequenceLine>('SELECT id,name,operator,operator_short FROM bd_line ORDER BY id')).rows,stations=(await db.query<SequenceStation>('SELECT id,name,line_id,lat,lon,seq,along_km,seq_src FROM bd_station ORDER BY id')).rows;
 const started=Date.now(),plan=planStationSequence(lines,stations,sequenceReference),oracle=spawnLegacyPython(['legacy/scripts/station-sequence-oracle.py'],{input:JSON.stringify({lines,stations,sources:sequenceReference}),encoding:'utf8',maxBuffer:4*1024*1024,timeout:120000});if(oracle.status!==0||oracle.error)throw Error('Legacy in-memory oracle failed');
 const old=JSON.parse(oracle.stdout),byId=new Map(plan.entries.map(row=>[row.stationId,row])),differences:Record<string,number>={};let oldMissing=0;
 for(const row of old){const actual=byId.get(row.stationId);if(!actual){oldMissing++;continue;}for(const key of ['seq','km','source'])if(JSON.stringify(row[key])!==JSON.stringify((actual as any)[key]))differences[key]=(differences[key]??0)+1;byId.delete(row.stationId);}
 const result={capturedAt:new Date().toISOString(),database:'store_settle',readOnly:true,lines:lines.length,stations:stations.length,summary:plan.summary,legacyPlanned:old.length,missingNew:oldMissing,missingOld:byId.size,fieldDifferences:differences,licenses:plan.licenses,ok:!oldMissing&&!byId.size&&!Object.keys(differences).length,elapsedMs:Date.now()-started};await mkdir('data/refactor',{recursive:true});await writeFile('data/refactor/p5-sequence-parity.json',JSON.stringify(result,null,2)+'\n',{mode:0o600});console.log(JSON.stringify(result,null,2));if(!result.ok)process.exitCode=1;
}finally{await db.onModuleDestroy();}
