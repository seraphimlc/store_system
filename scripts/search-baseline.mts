/** Local, read-only, repeatable snapshot. Never queries production or raw_records. */
import {createRequire} from 'node:module';
import {createHash,randomBytes} from 'node:crypto';
import {mkdir,open,readFile,writeFile} from 'node:fs/promises';
import {join,resolve} from 'node:path';
import {storeSearchDocument} from '../packages/domain/src/store-search-document';
import {storeSearchSql,STORE_SEARCH_VERSION,STORE_NORMALIZER_VERSION} from '../packages/domain/src/store-search';
const {Pool}=createRequire(new URL('../apps/server/package.json',import.meta.url))('pg');
const url=new URL(process.env.NEXT_DATABASE_URL??'');
if(!['postgres:','postgresql:'].includes(url.protocol)||!['localhost','127.0.0.1','[::1]'].includes(url.hostname)||url.pathname!=='/store_settle')throw Error('Explicit local store_settle required; production is prohibited');
url.searchParams.set('options','-c default_transaction_read_only=on');
const version=new Date().toISOString().replace(/[:.]/g,'-')+'-'+randomBytes(4).toString('hex');
const directory=resolve('data/refactor/search-evaluation',version);await mkdir(directory,{recursive:true,mode:0o700});
const pool=new Pool({connectionString:url.href,max:1,application_name:'store-search-baseline-readonly'}),client=await pool.connect();
const salt=randomBytes(32).toString('hex');const hash=(s:string)=>createHash('sha256').update(s).digest('hex');
const report:any={version,capturedAt:new Date().toISOString(),database:'store_settle',readOnly:true,strategyVersion:STORE_SEARCH_VERSION,normalizerVersion:STORE_NORMALIZER_VERSION,productionAccessed:false,files:[],tierOne:{status:'unknown_until_export'},tierTwo:{evidence:'recomputed on frozen local snapshot',identityLabels:'unverified name candidates only'}};
async function exportRows(name:string,query:string,transform=(row:any)=>row){
 const file=await open(join(directory,name+'.jsonl'),'wx',0o600),digest=createHash('sha256');let count=0;
 try{await client.query('DECLARE sample_cursor NO SCROLL CURSOR FOR '+query);while(true){const rows=(await client.query('FETCH 2000 FROM sample_cursor')).rows;if(!rows.length)break;for(const row of rows){const text=JSON.stringify(transform(row))+'\n';digest.update(text);await file.write(text);count++;}}await client.query('CLOSE sample_cursor');}finally{await file.close();}
 const result={file:name+'.jsonl',rows:count,sha256:digest.digest('hex')};report.files.push(result);return result;
}
try{
 await client.query('BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY');await client.query("SET LOCAL statement_timeout='120s'");
 const legacySource=await readFile(new URL('./search-legacy-reference.ts',import.meta.url),'utf8');await writeFile(join(directory,'mobile-visits.legacy.ts'),legacySource,{mode:0o600,flag:'wx'});report.referenceSql={file:'mobile-visits.legacy.ts',sha256:hash(legacySource)};
 report.snapshot=(await client.query("SELECT transaction_timestamp() AS cutoff,txid_current_snapshot()::text AS transaction_snapshot,current_setting('transaction_read_only') AS read_only")).rows[0];
 await exportRows('entities','SELECT id,name_local FROM store_entities ORDER BY id');
 await exportRows('merchants','SELECT name,place_id,overture_id,osm_id,address,lat,lon FROM public.kanto_merchants_v20261029',row=>({...row,candidateKey:hash(JSON.stringify(row))}));
 await exportRows('task-snapshots',`SELECT id,grid_task_id,store_id,snapshot,status,result->>'business_status' AS business_status FROM bd_store_task ORDER BY id`);
 await exportRows('task-search-documents','SELECT id,grid_task_id,store_id,snapshot,revision FROM bd_store_task ORDER BY id',storeSearchDocument);
 await exportRows('scope',`SELECT g.id,g.grid_id,g.region_task_id,g.snapshot,r.main_task_id,m.status AS batch_status FROM bd_grid_task g JOIN bd_region_task r ON r.id=g.region_task_id JOIN bd_main_task m ON m.id=r.main_task_id ORDER BY g.id`);
 const log=(await client.query("SELECT count(*)::int AS total,max(id) AS watermark FROM bd_store_search_log WHERE page=1 AND btrim(query_text)<>''")).rows[0];
 await exportRows('local-search-requests',`SELECT id,actor_id,main_task_id,region_task_id,grid_task_id,query_text,page,task_state,business_status,used_location,request_id,query_session_id,result_task_ids,context_duration_ms,query_duration_ms,matched_count,keyword_match_count,normalized_match_count,no_result_reason,strategy_version,duration_ms,created_at FROM bd_store_search_log WHERE page=1 AND btrim(query_text)<>'' ORDER BY created_at,id`,row=>{const {actor_id,...rest}=row;return {...rest,actor:actor_id===null?null:hash(salt+actor_id),label:'unknown',scopeEvidence:'capture-time snapshot; historical scope/location may differ'};});
 await exportRows('local-search-feedback',`SELECT event_id,search_log_id,actor_id,kind,store_task_id,suggested_name,strategy_version,created_at FROM bd_store_search_feedback ORDER BY created_at,event_id`,row=>{const {actor_id,...rest}=row;return {...rest,actor:hash(salt+actor_id),label:row.kind==='confirmed'?'user-explicit-unreviewed':'interaction-not-ground-truth'};});
 report.tierOne={...log,status:log.total?'local requests exported; origins and targets require labeling':'no local raw request samples',productionObservation:{source:'previous read-only observation supplied in conversation; not exported raw samples',asOfSingapore:'2026-11-13 15:57',requests:19,distinctQueries:16,withResults:7,zeroResults:12,resultRatePercent:36.84},limitation:'No production access in this run. Historical counts do not supply ground truth, ranks or exact coordinates.'};
 const norm=storeSearchSql('name');
 report.tierTwo.summary=(await client.query(`WITH raw AS(SELECT name,count(*)::bigint AS n FROM public.kanto_merchants_v20261029 WHERE name IS NOT NULL GROUP BY name),norm AS(SELECT ${norm} AS key,count(*)::bigint AS n FROM public.kanto_merchants_v20261029 GROUP BY 1),matches AS(SELECT e.id,e.name_local,${storeSearchSql('e.name_local')} AS key,coalesce(r.n,0) AS raw_count,CASE WHEN ${storeSearchSql('e.name_local')}<>'' THEN coalesce(n.n,0) ELSE 0 END AS norm_count FROM store_entities e LEFT JOIN raw r ON r.name=e.name_local LEFT JOIN norm n ON n.key=${storeSearchSql('e.name_local')}) SELECT count(*)::int AS entities,(SELECT count(*)::int FROM public.kanto_merchants_v20261029) AS merchants,count(*) FILTER(WHERE coalesce(name_local,'')='')::int AS missing_name,count(*) FILTER(WHERE raw_count>0)::int AS raw_matches,count(*) FILTER(WHERE raw_count=1)::int AS raw_unique,count(*) FILTER(WHERE raw_count>1)::int AS raw_ambiguous,count(*) FILTER(WHERE raw_count=0)::int AS raw_missing,count(DISTINCT name_local) FILTER(WHERE raw_count>0)::int AS raw_names,count(*) FILTER(WHERE norm_count>0)::int AS normalized_matches,count(*) FILTER(WHERE norm_count=1)::int AS normalized_unique,count(*) FILTER(WHERE norm_count>1)::int AS normalized_ambiguous,count(*) FILTER(WHERE norm_count=0)::int AS normalized_missing,count(DISTINCT key) FILTER(WHERE norm_count>0)::int AS normalized_names,max(norm_count)::int AS maximum_candidates,count(*) FILTER(WHERE norm_count BETWEEN 2 AND 10)::int AS candidates_2_10,count(*) FILTER(WHERE norm_count BETWEEN 11 AND 100)::int AS candidates_11_100,count(*) FILTER(WHERE norm_count>100)::int AS candidates_over_100 FROM matches`)).rows[0];
 await exportRows('entity-candidate-counts',`WITH raw AS(SELECT name,count(*)::int AS n FROM public.kanto_merchants_v20261029 WHERE name IS NOT NULL GROUP BY name),norm AS(SELECT ${norm} AS key,count(*)::int AS n FROM public.kanto_merchants_v20261029 GROUP BY 1) SELECT e.id,e.name_local,${storeSearchSql('e.name_local')} AS normalized_name,coalesce(r.n,0) AS raw_candidates,CASE WHEN ${storeSearchSql('e.name_local')}<>'' THEN coalesce(n.n,0) ELSE 0 END AS normalized_candidates FROM store_entities e LEFT JOIN raw r ON r.name=e.name_local LEFT JOIN norm n ON n.key=${storeSearchSql('e.name_local')} ORDER BY e.id`,row=>({...row,label:'unverified',splitGroup:hash(row.normalized_name||'entity:'+row.id)}));
 report.gridSizes=(await client.query('WITH sizes AS(SELECT grid_task_id,count(*) AS n FROM bd_store_task GROUP BY grid_task_id) SELECT count(*)::int AS grids,min(n)::int AS minimum,max(n)::int AS maximum,percentile_cont(0.95) WITHIN GROUP(ORDER BY n) AS p95 FROM sizes')).rows[0];
 await client.query('COMMIT');report.complete=true;
 await writeFile(join(directory,'manifest.json'),JSON.stringify(report,null,2)+'\n',{mode:0o600});
 console.log(JSON.stringify({directory,complete:report.complete,tierOne:report.tierOne,tierTwo:report.tierTwo,gridSizes:report.gridSizes,files:report.files.map((f:any)=>({file:f.file,rows:f.rows}))},null,2));
}catch(e){await client.query('ROLLBACK');report.complete=false;await writeFile(join(directory,'manifest.incomplete.json'),JSON.stringify(report,null,2),{mode:0o600});throw e;}finally{client.release();await pool.end();}
