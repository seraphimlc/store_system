/** OSM retrieval: offline cache inspection unless network is explicitly requested. */
import {readFile,stat,mkdir,writeFile} from 'node:fs/promises';import {resolve,dirname} from 'node:path';import {osmRelationIds} from '../packages/domain/src/osm-routes';import {fetchOsmRouteBatch,discoverOsmRouteIds} from '../apps/server/src/osm-route-source';import {publishRailFile} from '../apps/server/src/rail-source';
const args=process.argv.slice(2),options:Record<string,string|boolean>={},flags=new Set(['--download','--refresh','--discover-ids']),values=new Set(['--ids','--only','--limit','--cache','--output','--ids-output','--seed','--workers']);for(let i=0;i<args.length;i++){if(flags.has(args[i]))options[args[i]]=true;else if(values.has(args[i])&&args[i+1]&&!args[i+1].startsWith('--'))options[args[i]]=args[++i];else throw Error('Use --ids <file>, --only <csv>, --limit <n>, --seed <snapshot>, --cache <dir>, --download, --refresh, --discover-ids, --ids-output <new-file>, --output <new-file>, --workers 1..4');}
if(['--only','--ids','--discover-ids'].filter(flag=>options[flag]).length>1)throw Error('Choose one ID source: --only, --ids or --discover-ids');
if(options['--refresh']&&!options['--download'])throw Error('--refresh requires --download');if(options['--discover-ids']&&!options['--download'])throw Error('--discover-ids requires --download');if(options['--ids-output']&&!options['--discover-ids'])throw Error('--ids-output requires explicit discovery');
let discovery:any=null,ids:number[];if(options['--only'])ids=osmRelationIds(String(options['--only']).split(',').map(Number));else if(options['--discover-ids']){discovery=await discoverOsmRouteIds();ids=discovery.ids;}else{const file=resolve(String(options['--ids']??'legacy/scripts/bd_osm_route_ids.json'));if((await stat(file)).size>4*1024*1024)throw Error('IDs file too large');ids=osmRelationIds(JSON.parse(await readFile(file,'utf8')));}
if(options['--limit']){const limit=Number(options['--limit']);if(!Number.isInteger(limit)||limit<1||limit>20000)throw Error('Invalid request limit');ids=ids.slice(0,limit);}
let seed:any[]=[];if(options['--seed']){const file=resolve(String(options['--seed']));if((await stat(file)).size>32*1024*1024)throw Error('Seed snapshot too large');const data=JSON.parse(await readFile(file,'utf8'));if(!Array.isArray(data.routes))throw Error('Invalid seed routes');seed=data.routes;}
const controller=new AbortController(),stop=()=>controller.abort();process.once('SIGINT',stop);process.once('SIGTERM',stop);
try{const result=await fetchOsmRouteBatch(ids,resolve(String(options['--cache']??'data/refactor/osm-cache')),{download:!!options['--download'],refresh:!!options['--refresh'],workers:options['--workers']?Number(options['--workers']):4,seed,signal:controller.signal});if(typeof options['--output']==='string'){const file=resolve(options['--output']);await mkdir(dirname(file),{recursive:true});await publishRailFile(file,JSON.stringify(result.payload)+'\n');}if(typeof options['--ids-output']==='string'){const file=resolve(options['--ids-output']);await mkdir(dirname(file),{recursive:true});await publishRailFile(file,JSON.stringify(discovery.ids)+'\n');}const report={capturedAt:new Date().toISOString(),databaseTouched:false,download:!!options['--download'],discovery:discovery?{ids:discovery.ids.length,endpoint:discovery.endpoint,errors:discovery.errors}:null,...result.report};await mkdir('data/refactor',{recursive:true});await writeFile('data/refactor/p5-osm-source.json',JSON.stringify(report,null,2)+'\n',{mode:0o600});console.log(JSON.stringify(report,null,2));if(options['--download']&&!result.report.complete)process.exitCode=1;}finally{process.off('SIGINT',stop);process.off('SIGTERM',stop);}
