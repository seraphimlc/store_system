/** Offline glyph-only coverage audit on verified private snapshots. No DB/network/runtime changes. */
import {createHash} from 'node:crypto';import {realpath,readFile,mkdir,writeFile} from 'node:fs/promises';import {join,relative,resolve} from 'node:path';
import {verifiedSnapshotFile} from './search-review.mjs';import {normalizeStoreQuery} from '../packages/domain/src/store-search';import {existingKanaKey,alternateKanaWriting,KANA_CANDIDATE_VERSION} from '../packages/domain/src/store-search-kana';
const root=await realpath('data/refactor/search-evaluation'),directory=await realpath(resolve(process.argv[2]??''));if(directory===root||relative(root,directory).startsWith('..'))throw Error('Verified private local snapshot required');
const manifest=JSON.parse(await readFile(join(directory,'manifest.json'),'utf8'));if(!manifest.complete||manifest.readOnly!==true||manifest.database!=='store_settle')throw Error('Expected complete local read-only snapshot');
const hash=(text:string)=>createHash('sha256').update(text).digest('hex');
const names=new Map<string,number>(),kana=new Map<string,{count:number;literalKeys:Set<string>}>();
await verifiedSnapshotFile(directory,manifest,'merchants.jsonl',(row:any)=>{if(typeof row.name!=='string')return;const literal=normalizeStoreQuery(row.name);if(!literal)return;names.set(literal,(names.get(literal)??0)+1);const key=existingKanaKey(row.name),group=kana.get(key)??{count:0,literalKeys:new Set<string>()};group.count++;group.literalKeys.add(literal);kana.set(key,group);});
const coverage={entities:0,missingNames:0,baseCovered:0,kanaCovered:0,newlyCovered:0,baseUnique:0,kanaUnique:0,baseAmbiguous:0,kanaAmbiguous:0,candidateInflated:0,previouslyUniqueNowAmbiguous:0,maximumCandidates:0},incremental:any[]=[];
await verifiedSnapshotFile(directory,manifest,'entities.jsonl',(row:any)=>{coverage.entities++;if(typeof row.name_local!=='string'||!normalizeStoreQuery(row.name_local)){coverage.missingNames++;return;}
 const original=names.get(normalizeStoreQuery(row.name_local))??0,group=kana.get(existingKanaKey(row.name_local)),folded=group?.count??0;
 if(original)coverage.baseCovered++;if(folded)coverage.kanaCovered++;if(original===1)coverage.baseUnique++;if(folded===1)coverage.kanaUnique++;if(original>1)coverage.baseAmbiguous++;if(folded>1)coverage.kanaAmbiguous++;if(folded>original)coverage.candidateInflated++;if(original===1&&folded>1)coverage.previouslyUniqueNowAmbiguous++;coverage.maximumCandidates=Math.max(coverage.maximumCandidates,folded);
 if(!original&&folded){coverage.newlyCovered++;incremental.push({entityId:row.id,query:row.name_local,baseCandidateCount:original,kanaCandidateCount:folded,distinctLiteralNameKeys:group!.literalKeys.size,label:'unverified name candidates; not a confirmed merchant link'});}
});
const scopes=new Map<number,Map<string,Set<string>>>(),selected:{taskId:number;gridId:number;name:string}[]=[];
await verifiedSnapshotFile(directory,manifest,'task-snapshots.jsonl',(row:any)=>{if(typeof row.snapshot?.name!=='string')return;const name=row.snapshot.name,literal=normalizeStoreQuery(name),key=existingKanaKey(name);if(!literal)return;const scope=scopes.get(row.grid_task_id)??new Map<string,Set<string>>(),keys=scope.get(key)??new Set<string>();keys.add(literal);scope.set(key,keys);scopes.set(row.grid_task_id,scope);
 if(alternateKanaWriting(name)!==name)selected.push({taskId:row.id,gridId:row.grid_task_id,name});
});
selected.sort((a,b)=>hash(String(a.taskId)).localeCompare(hash(String(b.taskId))));const samples=selected.slice(0,100).map(row=>{const q=alternateKanaWriting(row.name),scope=scopes.get(row.gridId)!,literal=normalizeStoreQuery(q),group=scope.get(existingKanaKey(q))!;const base=group.has(literal);return {taskId:row.taskId,gridId:row.gridId,sourceName:row.name,query:q,originalNameKeyPresent:base,kanaNameKeyPresent:true,distinctLiteralNameKeys:group.size,label:'derived alternate kana; target known only because it was generated from this task'};});
let collidingGridKeys=0;for(const scope of scopes.values())for(const values of scope.values())if(values.size>1)collidingGridKeys++;
const report={version:KANA_CANDIDATE_VERSION,snapshot:manifest.version,source:'verified local frozen JSONL only',sourceFiles:manifest.files.filter((f:any)=>['merchants.jsonl','entities.jsonl','task-snapshots.jsonl'].includes(f.file)),coverage,merchantFoldedGroupsWithDifferentLiteralKeys:[...kana.values()].filter(g=>g.literalKeys.size>1).length,collidingGridNameKeys:collidingGridKeys,derivedVariants:{n:samples.length,baseNameKeyRecall:samples.length?samples.filter(r=>r.originalNameKeyPresent).length/samples.length:null,kanaNameKeyRecall:samples.length?1:null,ambiguousNameGroups:samples.filter(r=>r.distinctLiteralNameKeys>1).length},decision:'Offline candidate evidence only: no runtime folding or identity merge. Review incremental and inflated groups with address/location/targets before enabling alternate recall. Kanji readings and romaji require separate provenance.',productionAccessed:false,databaseWritten:false};
const output=join(directory,'kana-experiments',new Date().toISOString().replace(/[:.]/g,'-'));await mkdir(output,{recursive:true,mode:0o700});await writeFile(join(output,'report.json'),JSON.stringify(report,null,2),{mode:0o600,flag:'wx'});await writeFile(join(output,'incremental-entity-candidates.json'),JSON.stringify(incremental,null,2),{mode:0o600,flag:'wx'});await writeFile(join(output,'derived-variants.json'),JSON.stringify(samples,null,2),{mode:0o600,flag:'wx'});console.log(JSON.stringify({output,...report},null,2));
