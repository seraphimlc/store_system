{
  "name": "store-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @store/server dev",
    "dev:admin": "pnpm --filter @store/admin dev",
    "dev:staff": "pnpm --filter @store/staff dev",
    "test": "node scripts/test-isolated.mjs",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test:integration": "node scripts/test-isolated.mjs --integration",
    "test:browser": "node scripts/test-isolated.mjs --browser",
    "release:build": "node --env-file-if-exists=.env --env-file-if-exists=.env.next.local scripts/release.mjs build",
    "release:deploy": "node --env-file-if-exists=.env --env-file-if-exists=.env.next.local scripts/release.mjs deploy",
    "release:rollback": "node --env-file-if-exists=.env --env-file-if-exists=.env.next.local scripts/release.mjs rollback",
    "test:browser:p3": "node --env-file=.env.next.local scripts/verify-p3-browser.mjs",
    "test:browser:plans": "node --env-file=.env.next.local scripts/verify-p3-plans-browser.mjs",
    "test:browser:messages": "node --env-file=.env.next.local scripts/verify-p3-messages-browser.mjs",
    "test:browser:reports": "node --env-file=.env.next.local scripts/verify-p3-remaining-browser.mjs",
    "test:browser:deletion": "node --env-file=.env.next.local scripts/verify-p4-deletion-browser.mjs",
    "test:browser:stores": "node --env-file=.env.next.local scripts/verify-p4-stores-browser.mjs",
    "test:browser:performance": "node --env-file=.env.next.local scripts/verify-p4-performance-browser.mjs",
    "test:history": "node --env-file=.env.next.local --import tsx scripts/verify-p4-history.mts",
    "test:rebuild": "node --env-file=.env.next.local --import tsx scripts/verify-p4-rebuild.mts",
    "test:browser:ops": "node scripts/test-isolated.mjs --browser --ops",
    "test:browser:maps": "node scripts/test-isolated.mjs --browser --maps",
    "zones:snapshot": "node --import tsx scripts/prepare-zone-snapshot.mts",
    "zones:preview": "node --import tsx scripts/preview-zone-snapshot.mts",
    "zones:release": "node --import tsx scripts/apply-zone-release.mts",
    "zones:source": "node --import tsx scripts/prepare-zone-source.mts",
    "zones:geometry": "node --import tsx scripts/prepare-osm-zone-geometry.mts",
    "zones:natural": "node --import tsx scripts/prepare-natural-grids.mts",
    "zones:bind": "node --import tsx scripts/bind-zone-merchants.mts",
    "zones:natural:import": "node --import tsx scripts/import-natural-grids.mts",
    "dev": "node scripts/dev.mjs",
    "assets:cors": "node --env-file-if-exists=.env --env-file-if-exists=.env.next.local scripts/verify-gcs-cors.mjs",
    "test:browser:management": "node scripts/test-isolated.mjs --browser --management",
    "test:browser:map-workspace": "node scripts/test-isolated.mjs --browser --map-workspace",
    "test:browser:messages-isolated": "node scripts/test-isolated.mjs --browser --messages"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1165.0",
    "@playwright/test": "1.65.0",
    "@types/node": "^22.0.0",
    "ali-oss": "6.23.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
