{
  "name": "store-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @store/server dev",
    "dev:admin": "pnpm --filter @store/admin dev",
    "dev:staff": "pnpm --filter @store/staff dev",
    "test": "node scripts/test-isolated.mjs",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test:integration": "node scripts/test-isolated.mjs --integration",
    "test:browser": "node scripts/test-isolated.mjs --browser",
    "release:build": "node --env-file-if-exists=.env --env-file-if-exists=.env.next.local scripts/release.mjs build",
    "release:deploy": "node --env-file-if-exists=.env --env-file-if-exists=.env.next.local scripts/release.mjs deploy",
    "release:rollback": "node --env-file-if-exists=.env --env-file-if-exists=.env.next.local scripts/release.mjs rollback",
    "test:browser:p3": "node --env-file=.env.next.local scripts/verify-p3-browser.mjs",
    "test:browser:plans": "node --env-file=.env.next.local scripts/verify-p3-plans-browser.mjs",
    "test:browser:messages": "node --env-file=.env.next.local scripts/verify-p3-messages-browser.mjs",
    "test:browser:reports": "node --env-file=.env.next.local scripts/verify-p3-remaining-browser.mjs",
    "test:browser:deletion": "node --env-file=.env.next.local scripts/verify-p4-deletion-browser.mjs",
    "test:browser:stores": "node --env-file=.env.next.local scripts/verify-p4-stores-browser.mjs",
    "test:browser:performance": "node --env-file=.env.next.local scripts/verify-p4-performance-browser.mjs",
    "test:history": "node --env-file=.env.next.local --import tsx scripts/verify-p4-history.mts",
    "test:rebuild": "node --env-file=.env.next.local --import tsx scripts/verify-p4-rebuild.mts",
    "test:browser:ops": "node scripts/test-isolated.mjs --browser --ops",
    "test:browser:maps": "node scripts/test-isolated.mjs --browser --maps",
    "zones:snapshot": "node --import tsx scripts/prepare-zone-snapshot.mts",
    "zones:preview": "node --import tsx scripts/preview-zone-snapshot.mts",
    "zones:release": "node --import tsx scripts/apply-zone-release.mts",
    "zones:source": "node --import tsx scripts/prepare-zone-source.mts",
    "zones:geometry": "node --import tsx scripts/prepare-osm-zone-geometry.mts",
    "zones:natural": "node --import tsx scripts/prepare-natural-grids.mts",
    "zones:bind": "node --import tsx scripts/bind-zone-merchants.mts",
    "zones:natural:import": "node --import tsx scripts/import-natural-grids.mts",
    "dev": "node scripts/dev.mjs",
    "assets:cors": "node --env-file-if-exists=.env --env-file-if-exists=.env.next.local scripts/verify-gcs-cors.mjs",
    "test:browser:management": "node scripts/test-isolated.mjs --browser --management",
    "test:browser:map-workspace": "node scripts/test-isolated.mjs --browser --map-workspace",
    "test:browser:messages-isolated": "node scripts/test-isolated.mjs --browser --messages",
    "release:bundle": "node --env-file-if-exists=.env --env-file-if-exists=.env.next.local scripts/release-bundle.mjs",
    "search:baseline": "node --env-file=.env.next.local --import tsx scripts/search-baseline.mts",
    "search:replay": "node --env-file=.env.next.local --import tsx scripts/search-replay.mts",
    "test:browser:search-input": "node scripts/verify-search-input-browser.mjs",
    "search:fuzzy-evaluate": "node scripts/test-isolated.mjs --file=apps/server/test/store-search-fuzzy-evaluation.test.ts",
    "test:browser:search-suggestions": "node scripts/verify-search-suggestions-browser.mjs",
    "test:browser:search-feedback": "node scripts/verify-search-feedback-browser.mjs",
    "search:retention": "node --env-file=.env.next.local scripts/search-log-retention.mjs",
    "test:browser:search-highlight": "node scripts/verify-search-highlight-browser.mjs",
    "test:browser:search-completion": "node scripts/verify-search-completion-browser.mjs",
    "test:search:integration": "node scripts/test-isolated.mjs --file=apps/server/test/store-search-acceptance.test.ts",
    "test:search:unit": "node --import tsx --test packages/domain/test/store-search.test.ts packages/domain/test/store-search-evidence.test.ts packages/domain/test/store-search-document.test.ts packages/domain/test/store-search-highlight.test.ts packages/domain/test/store-similarity.test.ts scripts/request.test.mjs scripts/search-log-retention.test.mjs packages/domain/test/store-name-compatibility.test.ts packages/domain/test/store-address-evidence.test.ts scripts/search-coverage-evaluation.test.mjs packages/domain/test/store-name-index.test.ts apps/server/test/store-name-retrieval.test.ts",
    "test:search:browser": "node scripts/search-browser-acceptance.mjs",
    "search:review": "node scripts/search-review.mjs",
    "test:search:rollback": "node --test scripts/release-transition.test.mjs scripts/search-release-rollback.test.mjs && node scripts/test-isolated.mjs --file=apps/server/test/store-search-migration-compatibility.test.ts",
    "search:kana-evaluate": "node --import tsx scripts/search-kana-evaluation.mts",
    "search:docker-stage": "node scripts/search-docker-stage.mjs",
    "test:search:restore": "node scripts/test-isolated.mjs --file=apps/server/test/store-search-backup-restore.test.ts",
    "test:browser:search-scope": "node scripts/verify-search-scope-browser.mjs",
    "search:coverage": "node --import tsx --max-old-space-size=6144 scripts/search-coverage-evaluation.mjs",
    "search:name-index-replay": "node --import tsx --max-old-space-size=6144 scripts/search-name-index-replay.mts"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1165.0",
    "@playwright/test": "1.65.0",
    "@types/node": "^22.0.0",
    "ali-oss": "6.23.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
