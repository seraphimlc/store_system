import{createRequire}from'node:module';import{writeFile}from'node:fs/promises';
import {gridViewport as before} from './before';import {gridViewport as after} from '../../apps/server/src/grid-viewport';
const require=createRequire(new URL('../../apps/server/package.json',import.meta.url));const{Pool}=require('pg');const url=new URL(process.env.NEXT_DATABASE_URL!);if(!['localhost','127.0.0.1','[::1]'].includes(url.hostname)||url.pathname!='/store_settle')throw Error('Local baseline only');const pool=new Pool({connectionString:url.href,max:1,options:'-c default_transaction_read_only=on',statement_timeout:10000});const c=await pool.connect();
const q={q:'',region:'tokyo23',state:'',west:139.56430603027343,east:139.95569396972655,south:35.51892601897698,north:35.840749489789644};
try{const actor=(await c.query("SELECT id FROM users WHERE role='admin' AND is_active AND status='active' ORDER BY id LIMIT 1")).rows[0].id;const results=[];
for(const variant of ['before','before','after','after']){let cursor=0,calls=0,sql=0,geometryReads=0,features=0;const start=performance.now();do{await c.query('BEGIN READ ONLY');try{const client={query:async(text:string,args:unknown[])=>{sql++;if(text.startsWith('SELECT id,geometry'))geometryReads++;return c.query(text,args);}};const page:any=await (variant==='before'?before(client as any,actor,{...q,after:cursor}):after(client as any,actor,{...q,after:cursor},'manifest'));features+=page.features.length;calls++;if(!page.hasMore)break;cursor=page.nextCursor;}finally{await c.query('ROLLBACK');}}while(calls<30);results.push({variant,ms:Math.round(performance.now()-start),calls,features,sql,geometryReads});}
await writeFile('data/grid-viewport-performance-20261117/result.json',JSON.stringify({readOnly:true,viewport:q,results},null,2));console.log(JSON.stringify(results));}finally{c.release();await pool.end()}
