# 片区预览默认只读 public.kanto_merchants_v20261029；snapshot仅供显式离线测试。
BD_ZONE_MERCHANT_SOURCE=postgresql

# 管理端作业片区预览：Google Maps 浏览器 key（配置 HTTP referrer 限制）
GOOGLE_PLACES_API_KEY=
GOOGLE_PUBLIC_API_KEY=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# 巡店照片：生产配置在deploy/.env；RAM仅授予该前缀PutObject权限，不要提交密钥。
STORE_FILES_OSS_ENDPOINT=
STORE_FILES_OSS_BUCKET=
STORE_FILES_CDN_BASE=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 临时凭据可选：OSS_SESSION_TOKEN；固定对象前缀store-system-files/
