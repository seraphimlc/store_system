# New stack only. Never point local write tests at the baseline/production database.
NEXT_DATABASE_URL=postgresql://store_settle:REPLACE@127.0.0.1:5433/store_settle_refactor_p1
# Docker-only override (put in a separate private .env.next.docker.local config).
# Dev continues using NEXT_DATABASE_URL; baseline Docker requires this explicit local URL.
# NEXT_DOCKER_DATABASE_URL=postgresql://store_settle:REPLACE@127.0.0.1:5433/store_settle
NEXT_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
NEXT_PORT=3000
NEXT_HOST=127.0.0.1
NEXT_COOKIE_SECURE=false

# Optional store-master AI batch switch. Model credentials stay in the private runtime env.
STORE_AI_BATCH=1

# Infer daily reconciliation columns only after deterministic header detection fails.
RECON_LAYOUT_AI=1

# Optional pinyin/romaji login candidates; errors fall back to deterministic names.
LOGIN_NAME_AI=1

# Optional existing local copy of legacy /data/uploads; mounted read-only into API/Worker.
# NEXT_LEGACY_UPLOAD_HOST_DIRECTORY=/absolute/path/to/legacy/uploads

# Build-time public OSM river evidence directory; matching files are frozen into the API image.
# NEXT_ZONE_DATA_DIRECTORY=/absolute/path/to/bd_zones

# Browser-restricted Google Maps JS public key (same contract as the legacy system).
# GOOGLE_PUBLIC_API_KEY=

